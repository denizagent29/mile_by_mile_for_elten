msgstr "Uruchom silnik"

msgid "Refuel"
msgstr "Zatankuj"

msgid "Fix the tire"
msgstr "Napraw oponę"

msgid "Repair after accident"
msgstr "Napraw po wypadku"

msgid "End of U-turn"
msgstr "Koniec zawracania"

msgid "End of speed limit"
msgstr "Koniec ograniczenia prędkości"

msgid "Engine immunity"
msgstr "Odporność na zgaśnięcie silnika"

msgid "Fuel immunity"
msgstr "Odporność na opróżnienie baku"

msgid "Tire immunity"
msgstr "Odporność na przebicie opony"

msgid "Accident immunity"
msgstr "Odporność na wypadki"

msgid "U-turn immunity"
msgstr "Odporność na zawracanie"

msgid "Speed limit immunity"
msgstr "Odporność na ograniczenie prędkości"

msgid "Turn-skip immunity"
msgstr "Odporność na pominięcie kolejki"

msgid "Strip all immunities"
msgstr "Zdejmij wszystkie odporności"

msgid "Thrown from the saddle"
msgstr "Zrzucenie z siodła"

msgid "Hunger"
msgstr "Głód"

msgid "Lost horseshoe"
msgstr "Zgubiona podkowa"

msgid "Exhaustion"
msgstr "Wyczerpanie"

msgid "Saddle up"
msgstr "Osiodłaj"

msgid "Feed"
msgstr "Nakarm"

msgid "Shoe the horse"
msgstr "Podkuj konia"

msgid "Rest"
msgstr "Odpoczynek"

msgid "Saddle immunity"
msgstr "Odporność na upadek z siodła"

msgid "Hunger immunity"
msgstr "Odporność na głód"

msgid "Horseshoe immunity"
msgstr "Odporność na utratę podkowy"

msgid "Exhaustion immunity"
msgstr "Odporność na wyczerpanie"

msgid "Multiplayer"
msgstr "Multiplayer"

msgid "Create a game"
msgstr "Utwórz grę"

msgid "Wait for an invitation"
msgstr "Czekaj na zaproszenie"

msgid "Back"
msgstr "Wstecz"

msgid "Opponent nickname"
msgstr "Nick przeciwnika"

msgid "Cannot verify the user. Check the connection."
msgstr "Nie można zweryfikować użytkownika. Sprawdź połączenie."

msgid "There is no user with this name."
msgstr "Nie ma użytkownika o takiej nazwie."

msgid "The user is offline. Send the invitation anyway?"
msgstr "Użytkownik jest offline. Mimo to wysłać zaproszenie?"

msgid "No response from %{nick}."
msgstr "Brak odpowiedzi od %{nick}."

msgid "%{nick} declined the invitation."
msgstr "%{nick} odrzucił zaproszenie."

msgid "Cancel waiting?"
msgstr "Przerwać oczekiwanie?"

msgid "Exit waiting for invitations?"
msgstr "Wyjdź z oczekiwania na zaproszenia?"

msgid "%{nick} invites you: %{settings}. Accept?"
msgstr "%{nick} zaprasza cię: %{settings}. Przyjąć?"

msgid "Cancel waiting for the start?"
msgstr "Przerwać oczekiwanie na start?"

msgid "The game is out of sync. Return to the menu."
msgstr "Gra rozsynchronizowała się. Powrót do menu."

msgid "By fate's will, %{nick} moves first."
msgstr "Z woli losu pierwszy rusza %{nick}."

msgid "The game is over."
msgstr "Gra zakończona."

msgid "%{nick} is at the finish line."
msgstr "%{nick} jest na mecie."

msgid "The bot"
msgstr "Bot"
