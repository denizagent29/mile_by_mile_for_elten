msgstr "Вы накачали колесо."

msgid "The bot fixed the tire."
msgstr "Бот накачал колесо."

msgid "You repaired your car."
msgstr "Вы починили машину."

msgid "The bot repaired its car."
msgstr "Бот починил машину."

msgid "You turned forward."
msgstr "Вы развернулись вперёд."

msgid "The bot turned forward."
msgstr "Бот развернулся вперёд."

msgid "You removed the speed limit."
msgstr "Вы убрали ограничение скорости."

msgid "The bot removed the speed limit."
msgstr "Бот убрал ограничение скорости."

msgid "You protected yourself from %{hazard}."
msgstr "Вы защитились от %{hazard}."

msgid "The bot protected itself from %{hazard}."
msgstr "Бот защитился от %{hazard}."

msgid "engine stalling"
msgstr "глушения мотора"

msgid "fuel draining"
